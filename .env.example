DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Prisma Client runtime: use Supabase Transaction Pooler (port 6543) on Vercel.
# Prisma CLI migrations: use the Direct connection, or Session Pooler (port 5432)
# when the local network cannot reach Supabase's IPv6 direct endpoint.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID="your_google_oauth_client_id"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI
# in your Google OAuth web client. Add the production callback URI in deployment.
# Copy this file to .env.local and replace the placeholder values.
# Keep .env.local private; it is ignored by git.
